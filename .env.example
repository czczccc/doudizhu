# 复制为 .env 后填写。只在服务端（server/llm-proxy.ts）读取，不会打包进前端。
# 也可以不填，直接在游戏的“对手设置”里输入 Key（保存在浏览器本地）。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# —— 防滥用（可选），说明见 README ——
# LLM_ALLOWED_MODELS=claude-opus-5-5,deepseek-chat
# LLM_ALLOW_CUSTOM_ENDPOINTS=false
# LLM_RATE_LIMIT=40
# TRUST_PROXY=false
# ACCESS_PASSWORD=
